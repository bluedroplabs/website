---
export interface Props { value: string; description: string; }
const { value, description } = Astro.props;
---

<article class="border-border-normal p-6 sm:odd:border-r">
  <h3 class="text-size-24 font-semibold text-default-heading">{value}</h3>
  <div class="mt-3 font-light leading-relaxed" set:html={description} />
</article>
