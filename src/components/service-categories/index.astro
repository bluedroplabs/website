---
export interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---

<section class="border-t border-border-normal">
  <header class="mx-auto max-w-[var(--breakpoint-2xl)] px-5 py-12 md:px-8 lg:px-16 lg:py-20">
    {eyebrow && <p class="font-mono text-size-14 uppercase text-brand-aqua">{eyebrow}</p>}
    <h2 class="mt-4 text-size-32 font-medium leading-tight lg:text-size-48" set:html={title} />
    {description && <div class="mt-5 max-w-3xl text-size-18 font-light" set:html={description} />}
  </header>
  <div class="mx-auto max-w-[var(--breakpoint-2xl)] divide-y divide-border-normal border-x border-border-normal">
    <slot name="categories" />
  </div>
</section>
