---
import { FeaturedText } from "@/components/FeaturedText/FeaturedText";

export interface Props {
  variant: "default" | "small";
  background: "none" | "sky";
  eyebrow?: string;
  title: string;
  description?: string;
  author?: string;
}

const { background, ...props } = Astro.props;
---

<FeaturedText {...props} bgVariant={background} />
