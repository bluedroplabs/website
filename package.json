{
  "name": "bluedroplabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate": "plop",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "type:check": "astro check",
    "check": "npm-run-all --continue-on-error lint format:check type:check",
    "fix": "npm-run-all --continue-on-error lint:fix format",
    "prepare": "husky",
    "lighthouse": "lhci autorun",
    "lighthouse:dev": "npx serve dist -l 3000",
    "convert:images": "node scripts/convert-hero-to-webp.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^5.0.4",
    "@drupal-api-client/json-api-client": "^1.4.1",
    "@drupal-canvas/headless": "^0.3.0",
    "@drupal-canvas/headless-astro": "^0.2.1",
    "@marker.io/browser": "^0.20.2",
    "@marsidev/react-turnstile": "^1.4.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.4",
    "astro": "^7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-react-parser": "^5.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-fast-marquee": "^1.6.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@drupal-canvas/cli": "^0.21.3",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-themes": "^9.1.10",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^9.1.10",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "plop": "^4.0.4",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.7": true
  }
}
