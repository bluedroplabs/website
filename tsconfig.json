{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/utils/*": ["./utils/*"],
      "@/types/*": ["./types/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/public/*": ["./public/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
      "@data/*": ["./src/data/*"],
      "@utils/*": ["./src/utils/*"],
      "next/image": ["./src/compat/NextImage.tsx"],
      "next/link": ["./src/compat/NextLink.tsx"],
      "next-themes": ["./src/compat/NextThemes.tsx"],
      "@next/third-parties/google": ["./src/compat/GoogleTags.tsx"]
    },
    "typeRoots": ["./node_modules/@types", "./types"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["node_modules", "out", "dist", "storybook-static"]
}
